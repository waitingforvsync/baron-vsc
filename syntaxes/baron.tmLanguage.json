{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Baron",
  "scopeName": "source.baron",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#basic-block"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#definition-statements"
    },
    {
      "include": "#label-def"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#za-directives"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#mnemonics-cmos"
    },
    {
      "include": "#mnemonics"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#local-label-ref"
    },
    {
      "include": "#section-attrs"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#word-operators"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.baron",
          "match": ";.*$"
        },
        {
          "name": "comment.line.backslash.baron",
          "match": "\\\\.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.baron",
      "begin": "\"",
      "end": "\"(?!\")",
      "patterns": [
        {
          "name": "constant.character.escape.baron",
          "match": "\"\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.character.baron",
          "match": "'[^'\\n]'"
        },
        {
          "name": "constant.numeric.hex.baron",
          "match": "[&$][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.baron",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.baron",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "label-def": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_)\\]])(\\.)(@)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.baron"
            },
            "2": {
              "name": "constant.language.local-label.baron"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_)\\]])(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.baron"
            },
            "2": {
              "name": "entity.name.function.label.baron"
            }
          }
        }
      ]
    },
    "local-label-ref": {
      "name": "constant.language.local-label.baron",
      "match": "@[+-]"
    },
    "definition-statements": {
      "patterns": [
        {
          "match": "(?i)\\b(macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.baron"
            },
            "2": {
              "name": "entity.name.function.macro.baron"
            }
          }
        },
        {
          "match": "(?i)\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.baron"
            },
            "2": {
              "name": "entity.name.function.baron"
            }
          }
        },
        {
          "match": "(?i)\\b(section)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.baron"
            },
            "2": {
              "name": "entity.name.type.section.baron"
            }
          }
        },
        {
          "match": "(?i)\\b(incsection)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.baron"
            },
            "2": {
              "name": "entity.name.type.section.baron"
            }
          }
        },
        {
          "match": "(?i)\\b(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.baron"
            },
            "2": {
              "name": "variable.other.baron"
            }
          }
        }
      ]
    },
    "za-directives": {
      "name": "support.type.zeropage.baron",
      "match": "(?i)\\b(za_pool|za_auto1|za_auto2|za_auto|za_unreachable|za_cancall|za_canjump|za_returnto|za_return|za_discard|za_entry|za_interrupt)\\b"
    },
    "directives": {
      "name": "keyword.control.directive.baron",
      "match": "(?i)\\b(equb|equs|equw|equd|skipto|skip|align|incbin|include|incsection|section|endsection|if|elif|else|endif|for|next|macro|endmacro|function|print|error|endbasic|basic)\\b"
    },
    "mnemonics-cmos": {
      "name": "keyword.other.mnemonic.cmos.baron",
      "match": "(?i)\\b(bra|dea|ina|phx|phy|plx|ply|stz|clr|trb|tsb)\\b"
    },
    "mnemonics": {
      "name": "keyword.other.mnemonic.baron",
      "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bitzp|bitabs|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)\\b"
    },
    "builtin-functions": {
      "name": "support.function.baron",
      "match": "(?i)\\b(lo|hi|abs|int|floor|round|trunc|ceil|sqrt|sin|cos|tan|asin|acos|atan|log|ln|exp|not|rnd|len|shape|rank|full|repeated|flatten|concat|zip|reverse|sort|sum|product|min|max|defined|codes|chr|find|is_string|is_number|error)\\s*(?=\\()"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.baron",
          "match": "(?i)\\b(true|false|pi)\\b"
        },
        {
          "name": "constant.language.pc.baron",
          "match": "(?i)\\bp%"
        }
      ]
    },
    "section-attrs": {
      "match": "(?i)\\b(org|load|exec|filename|cmos|guard)\\s*(?==[^=])",
      "name": "variable.parameter.attribute.baron"
    },
    "assignment": {
      "match": "(?i)^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?==(?!=))",
      "captures": {
        "1": {
          "name": "variable.other.definition.baron"
        }
      }
    },
    "word-operators": {
      "name": "keyword.operator.word.baron",
      "match": "(?i)\\b(div|mod|or)\\b"
    },
    "registers": {
      "match": "(?i)(,)\\s*(x|y)\\b",
      "captures": {
        "1": {
          "name": "punctuation.separator.baron"
        },
        "2": {
          "name": "variable.language.register.baron"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.baron",
          "match": "\\.\\.<|\\.\\."
        },
        {
          "name": "keyword.operator.baron",
          "match": "<<|>>|<=|>=|==|!=|<>|[-+*/^=<>#~]"
        }
      ]
    },
    "basic-block": {
      "begin": "(?i)^\\s*(basic)\\s*(?=$|;|\\\\|:)",
      "end": "(?i)^\\s*(endbasic)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.baron"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.directive.baron"
        }
      },
      "contentName": "meta.embedded.block.bbcbasic.baron",
      "patterns": [
        {
          "name": "comment.line.semicolon.baron",
          "match": "^\\s*;.*$"
        },
        {
          "name": "comment.line.backslash.baron",
          "match": "^\\s*\\\\.*$"
        },
        {
          "match": "^(\\s*)(\\d+)(\\s*)(\\*.*)$",
          "captures": {
            "2": {
              "name": "constant.numeric.line-number.bbcbasic.baron"
            },
            "4": {
              "name": "keyword.other.star-command.bbcbasic.baron"
            }
          }
        },
        {
          "match": "(?<=:)\\s*(\\*.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.star-command.bbcbasic.baron"
            }
          }
        },
        {
          "name": "constant.numeric.line-number.bbcbasic.baron",
          "match": "^\\s*\\d+"
        },
        {
          "name": "string.quoted.double.bbcbasic.baron",
          "begin": "\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.baron",
              "match": "\"\""
            }
          ]
        },
        {
          "match": "(REM)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.bbcbasic.baron"
            },
            "2": {
              "name": "comment.line.rem.bbcbasic.baron"
            }
          }
        },
        {
          "match": "(DATA|D(?:AT|A)?\\.)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.bbcbasic.baron"
            },
            "2": {
              "name": "string.unquoted.data.bbcbasic.baron"
            }
          }
        },
        {
          "match": "(PROC|PRO\\.|FN)([A-Za-z0-9_`]*)",
          "captures": {
            "1": {
              "name": "keyword.control.bbcbasic.baron"
            },
            "2": {
              "name": "entity.name.function.bbcbasic.baron"
            }
          }
        },
        {
          "name": "keyword.control.bbcbasic.baron",
          "match": "(?:ENDPRO|ENDPR|REPOR|RETUR|CLEA|CLOS|COUN|ENDP|FALS|HIME|LOME|REPO|RETU|BGE|BPU|CLE|CLO|COU|END|FAL|HIM|LOM|PAG|RET|STO|TIM|TRU|VPO|BG|BP|CL|EN|EO|ER|FA|HI|OL|PA|PT|RE|RN|RU|TI|VP|B|E|H|O|R)\\.(?![0-9A-Za-z_`])"
        },
        {
          "name": "keyword.control.bbcbasic.baron",
          "match": "(?:ENVELOP|RENUMBE|STRING\\$|ENVELO|OPENOU|RENUMB|RESTOR|RIGHT\\$|STRING|COLOU|DELET|ENVEL|INKEY|INSTR|LEFT\\$|OPENI|OPENO|OPENU|POINT|RENUM|REPEA|RESTO|RIGHT|STRIN|ADVA|CHAI|COLO|DELE|ENVE|ERRO|GOSU|INKE|INPU|INST|LEFT|LOCA|MID\\$|OPEN|OSCL|POIN|PRIN|RENU|REPE|REST|RIGH|SOUN|STRI|TRAC|UNTI|WIDT|ADV|AUT|CAL|CHA|CHR|COL|DAT|DEL|DRA|EDI|ELS|ENV|ERR|EVA|GCO|GET|GOS|GOT|INK|INP|INS|LEF|LIN|LIS|LOA|LOC|MID|MOD|MOV|NEX|OPE|OSC|PLO|POI|PRI|PRO|REA|REN|REP|RES|RIG|SAV|SOU|STE|STR|TAB|THE|TRA|UNT|WID|AB|AC|AD|AN|AS|AT|AU|CA|CH|CO|DA|DE|DI|DR|ED|EL|EV|EX|FO|GC|GE|GO|IN|LE|LI|LO|MI|MO|NE|NO|OF|OP|OS|PL|PO|PR|RA|RI|SA|SG|SI|SO|SP|SQ|ST|TA|TH|TR|UN|US|VA|VD|WI|A|C|D|F|G|I|L|M|N|P|S|T|U|V|W)\\."
        },
        {
          "name": "keyword.control.bbcbasic.baron",
          "match": "AND|ABS|ACS|ADVAL|ASC|ASN|ATN|AUTO|BGET(?![0-9A-Za-z_`])|BPUT(?![0-9A-Za-z_`])|COLOUR|CALL|CHAIN|CHR\\$|CLEAR(?![0-9A-Za-z_`])|CLOSE(?![0-9A-Za-z_`])|CLG(?![0-9A-Za-z_`])|CLS(?![0-9A-Za-z_`])|COS|COUNT(?![0-9A-Za-z_`])|COLOR|DATA|DEG|DEF|DELETE|DIV|DIM|DRAW|ENDPROC(?![0-9A-Za-z_`])|END(?![0-9A-Za-z_`])|ENVELOPE|ELSE|EVAL|ERL(?![0-9A-Za-z_`])|ERROR|EOF(?![0-9A-Za-z_`])|EOR|ERR(?![0-9A-Za-z_`])|EXP|EXT(?![0-9A-Za-z_`])|EDIT|FOR|FALSE(?![0-9A-Za-z_`])|FN|GOTO|GET\\$|GET|GOSUB|GCOL|HIMEM(?![0-9A-Za-z_`])|INPUT|IF|INKEY\\$|INKEY|INT|INSTR\\(|LIST|LINE|LOAD|LOMEM(?![0-9A-Za-z_`])|LOCAL|LEFT\\$\\(|LEN|LET|LOG|LN|MID\\$\\(|MODE|MOD|MOVE|NEXT|NEW(?![0-9A-Za-z_`])|NOT|OLD(?![0-9A-Za-z_`])|ON|OFF|OR|OPENIN|OPENOUT|OPENUP|OSCLI|PRINT|PAGE(?![0-9A-Za-z_`])|PTR(?![0-9A-Za-z_`])|PI(?![0-9A-Za-z_`])|PLOT|POINT\\(|PROC|POS(?![0-9A-Za-z_`])|RETURN(?![0-9A-Za-z_`])|REPEAT|REPORT(?![0-9A-Za-z_`])|READ|REM|RUN(?![0-9A-Za-z_`])|RAD|RESTORE|RIGHT\\$\\(|RND(?![0-9A-Za-z_`])|RENUMBER|STEP|SAVE|SGN|SIN|SQR|SPC|STR\\$|STRING\\$\\(|SOUND|STOP(?![0-9A-Za-z_`])|TAN|THEN|TO|TAB\\(|TRACE|TIME(?![0-9A-Za-z_`])|TRUE(?![0-9A-Za-z_`])|UNTIL|USR|VDU|VAL|VPOS(?![0-9A-Za-z_`])|WIDTH"
        },
        {
          "name": "constant.numeric.hex.bbcbasic.baron",
          "match": "&[0-9A-F]+"
        },
        {
          "name": "constant.numeric.decimal.bbcbasic.baron",
          "match": "[0-9][0-9.]*|\\.[0-9.]*"
        },
        {
          "name": "variable.other.bbcbasic.baron",
          "match": "[A-Za-z_`][A-Za-z0-9_`]*"
        },
        {
          "name": "keyword.operator.bbcbasic.baron",
          "match": "<=|>=|<>|<<|>>|[-+*/^=<>?!$;]"
        }
      ]
    }
  }
}
